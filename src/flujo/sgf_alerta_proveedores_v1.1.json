    {
      "parameters": {
        "jsCode": "// Compara proveedores habituales activos contra las facturas recibidas este mes.\nconst mes = $('¿Es fin de mes?').first().json.mes;\nconst limpiaRut = r => String(r || '').replace(/\\./g, '').trim().toUpperCase();\nconst recibidos = new Set(\n  $('Leer facturas').all().map(i => i.json)\n    .filter(f => f.rut_emisor && String(f.fecha_emision || f.fecha_recepcion || '').startsWith(mes))\n    .map(f => limpiaRut(f.rut_emisor))\n);\nconst faltan = $('Leer proveedores mensuales').all().map(i => i.json)\n  .filter(p => p.rut_emisor && String(p.activo).toUpperCase() === 'SI' && !recibidos.has(limpiaRut(p.rut_emisor)));\nif (!faltan.length) return [];\nconst filas = faltan.map(p =>\n  `<tr><td>${p.razon_social}</td><td>${p.rut_emisor}</td><td>${p.servicio || ''}</td><td>${p.patron_facturacion || ''}</td></tr>`).join('');\nconst html = `<p>Las siguientes empresas no han facturado este mes (${mes}):</p>\n<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\">\n<tr><th>Empresa</th><th>RUT</th><th>Servicio</th><th>Patrón de facturación</th></tr>${filas}</table>\n<p>Mensaje automático del sistema de facturas SGFertility.</p>`;\nreturn [{ json: { mes, cantidad: faltan.length, html, empresas: faltan.map(p => p.razon_social).join(', ') } }];"
      },
