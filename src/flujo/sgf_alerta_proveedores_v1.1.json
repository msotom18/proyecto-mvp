      "parameters": {
        "jsCode": "// Solo sigue el último día del mes (o siempre si lo ejecutas manualmente para probar).\nconst hoy = new Date();\nconst ultimo = new Date(hoy.getFullYear(), hoy.getMonth() + 1, 0).getDate();\nif (hoy.getDate() !== ultimo && $execution.mode !== 'manual') return [];\nconst mes = hoy.getFullYear() + '-' + String(hoy.getMonth() + 1).padStart(2, '0');\nreturn [{ json: { mes } }];"
      },
